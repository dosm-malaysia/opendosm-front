{
  "name": "opendosm-front",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "lambda/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "e2e:test": "turbo run e2e:test",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "lint-staged": {
    "*.{js,ts,tsx,css,md}": "prettier --write"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "eslint-config-datagovmy": "*",
    "husky": ">=6",
    "inquirer-recursive": "^0.0.7",
    "lint-staged": "^17.6.0",
    "plop": "^3.1.2",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.1",
    "turbo": "^2.9.14",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@1.22.19",
  "dependencies": {},
  "resolutions": {
    "handlebars": "^4.7.10",
    "i18next-fs-backend": "^2.6.9",
    "d3-color": "^3.1.0",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.16.0",
    "lodash": "^4.18.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "browserslist": "^4.28.7",
    "cross-spawn": "^7.0.5",
    "tmp": "^0.2.6",
    "flatted": "^3.4.2",
    "serialize-javascript": "^7.0.5",
    "rollup": "^2.80.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "@babel/runtime": "^7.26.10",
    "@babel/helpers": "^7.26.10",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
}
